{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "krun-workerd-execution-pool",
  "title": "krun workerd 执行池实验",
  "schemaVersion": 41,
  "tags": [
    "krun",
    "workerd",
    "experiment"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(krun_execution_slot_ready, job)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(krun_execution_slot_ready{job=~\"${job:regex}\"}, namespace)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(krun_execution_slot_ready{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\"}, pod)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "execution_group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(krun_execution_slot_ready{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\"}, execution_group)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "workerd_slot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(krun_execution_slot_ready{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\"}, workerd_slot)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "workerd 主线程 CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "krun_execution_slot_cpu_cores{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\",workerd_slot=~\"${workerd_slot:regex}\"}",
          "legendFormat": "{{pod}} / {{workerd_slot}}"
        },
        {
          "refId": "B",
          "expr": "max by (execution_group) (krun_execution_slot_cpu_high_watermark_cores{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\",workerd_slot=~\"${workerd_slot:regex}\"})",
          "legendFormat": "{{execution_group}} 停投水位"
        },
        {
          "refId": "C",
          "expr": "max by (execution_group) (krun_execution_slot_cpu_resume_watermark_cores{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\",workerd_slot=~\"${workerd_slot:regex}\"})",
          "legendFormat": "{{execution_group}} 恢复水位"
        }
      ]
    },
    {
      "id": 2,
      "title": "workerd 在途额度占用",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "krun_execution_slot_in_flight{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\",workerd_slot=~\"${workerd_slot:regex}\"} / krun_execution_slot_in_flight_limit{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\",workerd_slot=~\"${workerd_slot:regex}\"}",
          "legendFormat": "{{pod}} / {{workerd_slot}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod CPU 和准入线",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "krun_execution_pod_cpu_cores{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\"}",
          "legendFormat": "{{namespace}} / {{pod}}"
        },
        {
          "refId": "B",
          "expr": "krun_execution_pod_cpu_admission_ceiling_cores{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\"}",
          "legendFormat": "{{namespace}} / {{pod}} 准入线"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pod 内存和冷加载准入线",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "krun_execution_pod_memory_bytes{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\"}",
          "legendFormat": "{{namespace}} / {{pod}}"
        },
        {
          "refId": "B",
          "expr": "krun_execution_pod_memory_admission_ceiling_bytes{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\"}",
          "legendFormat": "{{namespace}} / {{pod}} 准入线"
        }
      ]
    },
    {
      "id": 5,
      "title": "执行选点失败原因",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (execution_group, listener, reason) (rate(krun_execution_route_admission_rejections_total{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{execution_group}} / {{listener}} / {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "选点结果速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (execution_group, outcome) (rate(krun_execution_routes_total{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{execution_group}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "冷加载速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(krun_execution_slot_cold_loads_total{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\",workerd_slot=~\"${workerd_slot:regex}\"}[$__rate_interval])",
          "legendFormat": "{{pod}} / {{workerd_slot}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "已装载 Worker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "krun_execution_slot_loaded{job=~\"${job:regex}\",namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",execution_group=~\"${execution_group:regex}\",workerd_slot=~\"${workerd_slot:regex}\"}",
          "legendFormat": "{{pod}} / {{workerd_slot}}"
        }
      ]
    }
  ]
}
