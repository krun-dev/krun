---
import DefaultPageTitle from "@astrojs/starlight/components/PageTitle.astro";
import TableOfContents from "@astrojs/starlight/components/TableOfContents.astro";

const { entry, toc } = Astro.locals.starlightRoute;
const hasSections = toc?.items.some((item) => item.slug !== "_top" || item.children.length > 0);
const id = entry.id.replace(/\.(md|mdx)$/, "") || "index";
const source = `/docs/${id}.md${import.meta.env.DEV ? "" : ".txt"}`;
const isInternal = id === "internal" || id.startsWith("internal/");
const workerPages = [
  "guides/component-workers",
  "guides/git-repositories",
  "guides/gitlab-integration",
  "guides/github-integration",
  "guides/workers-runtime-compatibility",
];
const wranglerPages = ["guides/cloudflare-workers", "guides/wrangler-configuration"];
const section = isInternal
  ? ["内部文档"]
  : wranglerPages.includes(id)
    ? ["命令行工具", "Wrangler 使用指南"]
    : id === "guides/krun-cli"
      ? ["命令行工具"]
      : workerPages.includes(id)
        ? ["组件", "计算 · Workers", ...(id.endsWith("-integration") ? ["Git 仓库集成"] : [])]
        : id === "guides/component-object-storage"
          ? ["组件"]
          : ["开始使用"];
const eyebrow = isInternal ? "● INTERNAL ONLY" : "● GETTING STARTED";
---
<div class="krun-breadcrumb">文档 <span>/</span> {section.map((label) => <>{label} <span>/</span>{" "}</>)} {Astro.locals.starlightRoute.entry.data.title}</div>
<div class="krun-title-row">
  <div>
    <div class="krun-eyebrow">{eyebrow}</div>
    <DefaultPageTitle />
    <p class="krun-description">{Astro.locals.starlightRoute.entry.data.description}</p>
  </div>
  <div class="krun-doc-actions">
    <a href={source} data-doc-source>查看原文 ↗</a>
    <button type="button" data-doc-copy hidden>复制 Markdown</button>
  </div>
</div>
<p class="krun-copy-error" data-doc-error role="alert" hidden>复制失败，请打开 Markdown 原文手动复制。</p>
{hasSections && (
  <div class="krun-inline-toc">
    <TableOfContents />
  </div>
)}
