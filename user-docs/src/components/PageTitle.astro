---
import DefaultPageTitle from "@astrojs/starlight/components/PageTitle.astro";
const id = Astro.locals.starlightRoute.entry.id.replace(/\.(md|mdx)$/, "") || "index";
const source = `/docs/${id}.md${import.meta.env.DEV ? "" : ".txt"}`;
const workerPages = [
  "guides/component-workers",
  "guides/git-repositories",
  "guides/gitlab-integration",
  "guides/github-integration",
  "guides/workers-runtime-compatibility",
];
const section = ["guides/krun-cli", "guides/cloudflare-workers"].includes(id)
  ? ["命令行工具"]
  : workerPages.includes(id)
    ? ["组件", "计算 · Workers", ...(id.endsWith("-integration") ? ["Git 仓库集成"] : [])]
    : id === "guides/component-object-storage"
      ? ["组件"]
      : ["开始使用"];
---
<div class="krun-breadcrumb">文档 <span>/</span> {section.map((label) => <>{label} <span>/</span>{" "}</>)} {Astro.locals.starlightRoute.entry.data.title}</div>
<div class="krun-title-row">
  <div>
    <div class="krun-eyebrow">● GETTING STARTED</div>
    <DefaultPageTitle />
    <p class="krun-description">{Astro.locals.starlightRoute.entry.data.description}</p>
  </div>
  <div class="krun-doc-actions">
    <a href={source} data-doc-source>查看原文 ↗</a>
    <button type="button" data-doc-copy hidden>复制 Markdown</button>
  </div>
</div>
<p class="krun-copy-error" data-doc-error role="alert" hidden>复制失败，请打开 Markdown 原文手动复制。</p>
