{
  "name": "krun-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && astro build --root user-docs && node scripts/package-starlight.mjs && ./scripts/build-cli-downloads.sh",
    "check": "tsc -b",
    "test": "go test ./...",
    "test:permissions": "node --experimental-strip-types --test web/src/lib/permissions.test.mjs",
    "test:i18n": "node --experimental-strip-types --test web/src/lib/i18n.test.mjs",
    "test:ui": "playwright test",
    "format:web": "prettier --write \"web/src/**/*.{ts,tsx,mjs,css,json}\"",
    "check:web-format": "prettier --check \"web/src/**/*.{ts,tsx,mjs,css,json}\"",
    "format:workers": "prettier --write \"workers/runtime/**/*.js\" \"workers/runtime/test/*.mjs\" deploy/workers-dev/storage.e2e.mjs deploy/workers-kind/cloudflare.e2e.mjs workers/runtime/package.json \"deploy/workers-dev/fixtures/*.{js,ts}\"",
    "check:workers-format": "prettier --check \"workers/runtime/**/*.js\" \"workers/runtime/test/*.mjs\" deploy/workers-dev/storage.e2e.mjs deploy/workers-kind/cloudflare.e2e.mjs workers/runtime/package.json \"deploy/workers-dev/fixtures/*.{js,ts}\"",
    "docs:dev": "astro dev --ignore-lock --root user-docs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "^3.0.0",
    "transliteration": "^2.7.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.9",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "astro": "^7.4.7",
    "parse5": "^7.3.0",
    "prettier": "3.8.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-page-actions": "^0.7.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "@astrojs/markdown-remark": "^7.3.0"
  },
  "engines": {
    "node": "^22.23.4 || >=24.0.0"
  }
}
