{
  // krun reads the same Workers fields used by Wrangler. The frontend is
  // already static; the platform never runs npm or a Node server at runtime.
  "name": "krun-workers-fullstack",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
