FROM debian:bookworm-slim

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && case "$TARGETARCH" in \
         amd64) expected=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f ;; \
         arm64) expected=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d ;; \
         *) echo "unsupported MinIO architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL --retry 3 \
       "https://github.com/minio/minio/releases/download/${MINIO_RELEASE}/minio.linux-${TARGETARCH}.${MINIO_RELEASE}" \
       -o /usr/local/bin/minio \
    && echo "$expected  /usr/local/bin/minio" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/minio \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
