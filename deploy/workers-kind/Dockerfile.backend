FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY generated/git-mock-ca.crt /usr/local/share/ca-certificates/krun-kind-git-mock.crt
RUN update-ca-certificates
WORKDIR /app
COPY generated/krun-server /app/krun-server
USER 1000:1000
CMD ["/app/krun-server","serve","--config","/config/control.yaml"]
