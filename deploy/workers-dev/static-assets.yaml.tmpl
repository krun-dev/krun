apiVersion: v1
kind: Service
metadata:
  name: static-assets
  namespace: workers-mvp
spec:
  selector: {}
  ports:
    - name: http
      protocol: TCP
      port: __MINIO_PORT__
      targetPort: __MINIO_PORT__
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: static-assets-local
  namespace: workers-mvp
  labels:
    kubernetes.io/service-name: static-assets
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: __MINIO_PORT__
endpoints:
  - addresses:
      - __MINIO_HOST__
