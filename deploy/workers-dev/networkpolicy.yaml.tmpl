apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: runtime
  namespace: workers-mvp
spec:
  podSelector:
    matchLabels:
      role: krun-runtime
  policyTypes: [Ingress, Egress]
  ingress:
    # Both network scopes terminate on their own Gateway instance, and both
    # instances forward to the same runtime Pods. The split happens above this
    # layer (route tables per instance); here both proxies must be admitted or
    # the public entry gets a connection timeout instead of a 404.
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kgateway-system
          podSelector:
            matchLabels:
              gateway.networking.k8s.io/gateway-name: workers-mvp
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kgateway-system
          podSelector:
            matchLabels:
              gateway.networking.k8s.io/gateway-name: workers-public
      ports:
        - protocol: TCP
          port: 8081
    # There is deliberately no pod/network ingress rule for management 8083.
    # Local-first reaches it only through kubectl port-forward; node-to-local-
    # pod traffic is exempt from NetworkPolicy by the Kubernetes contract.
  egress:
    # Both MinIO and the control plane run on the development machine. Keep the
    # destination explicit so local-first cannot silently depend on a cluster
    # storage deployment.
    - to:
        - ipBlock:
            cidr: __MINIO_HOST__/32
      ports:
        - protocol: TCP
          port: __MINIO_PORT__
    - to:
        - ipBlock:
            cidr: __CONTROL_HOST__/32
      ports:
        - protocol: TCP
          port: 9001
