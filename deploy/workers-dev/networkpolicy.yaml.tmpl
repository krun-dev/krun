apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: runtime
  namespace: workers-mvp
spec:
  podSelector:
    matchLabels:
      role: krun-runtime
  policyTypes: [Ingress, Egress]
  ingress:
    # Both network scopes terminate on their own Gateway instance, and both
    # instances forward to the same runtime Pods. The split happens above this
    # layer (route tables per instance); here both proxies must be admitted or
    # the public entry gets a connection timeout instead of a 404.
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kgateway-system
          podSelector:
            matchLabels:
              gateway.networking.k8s.io/gateway-name: workers-mvp
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kgateway-system
          podSelector:
            matchLabels:
              gateway.networking.k8s.io/gateway-name: workers-public
      ports:
        - protocol: TCP
          port: 8081
    - ports:
        - protocol: TCP
          port: 8083
  egress:
    # MinIO runs in this namespace, so object storage is reached by pod selector
    # rather than a host IP; the control plane stays outside the cluster.
    - to:
        - podSelector:
            matchLabels:
              app: minio
      ports:
        - protocol: TCP
          port: 9000
    - to:
        - ipBlock:
            cidr: __CONTROL_HOST__/32
      ports:
        - protocol: TCP
          port: 9001
