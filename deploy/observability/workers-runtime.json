{
  "uid": "krun-workers-runtime",
  "title": "krun Workers Runtime",
  "schemaVersion": 41,
  "tags": ["krun", "workers"],
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
        "query": "label_values({job=~\"krun-kubelet-cadvisor|krun-worker-runtime\",__name__=~\"container_memory_working_set_bytes|up\",pod!=\"\"}, namespace)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
        "query": "label_values({job=~\"krun-kubelet-cadvisor|krun-worker-runtime\",__name__=~\"container_memory_working_set_bytes|up\",pod!=\"\",namespace=~\"$namespace\"}, pod)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "title": "Runtime configuration convergence",
      "description": "1 means the Pod applied the last configuration feed head and has a recent accepted ACK. 0 means it has yet to converge.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "krun_runtime_config_converged{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Worker ingress probes",
      "description": "1 means the configured business HTTPS URL returned the expected canary response from the probe network.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"krun-worker-ingress\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Business requests",
      "description": "Completed HTTP calls forwarded to business Workers, grouped by runtime pool. Direct static assets are excluded.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pool) (rate(krun_worker_requests_total{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{pool}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Business 5xx rate",
      "description": "Share of forwarded requests that returned HTTP 5xx or failed before receiving a response.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pool) (rate(krun_worker_requests_total{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\",status_class=\"5xx\"}[$__rate_interval])) / (sum by (namespace, pool) (rate(krun_worker_requests_total{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{namespace}}/{{pool}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Business response latency",
      "description": "Time from runtime dispatch to response headers, including cold load when needed.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (namespace, pool, le) (rate(krun_worker_request_duration_seconds_bucket{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{namespace}}/{{pool}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (namespace, pool, le) (rate(krun_worker_request_duration_seconds_bucket{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{namespace}}/{{pool}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (namespace, pool, le) (rate(krun_worker_request_duration_seconds_bucket{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{namespace}}/{{pool}} p99"
        }
      ]
    },
    {
      "id": 9,
      "title": "Bundle loads",
      "description": "Per-second rate of serving bundle preparation on loader cache misses, grouped by outcome.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pool, outcome) (rate(krun_worker_bundle_load_duration_seconds_count{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{pool}} {{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Bundle load latency",
      "description": "P95 time to fetch, verify and prepare a serving Worker bundle. Includes successful preparations.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (namespace, pool, le) (rate(krun_worker_bundle_load_duration_seconds_bucket{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\",outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "{{namespace}}/{{pool}} p95"
        }
      ]
    },
    {
      "id": 11,
      "title": "Runtime scrape health",
      "description": "Each serving Pod should report 1. Pods without a metrics port do not appear.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"krun-worker-runtime\",namespace=~\"$namespace\",pod=~\"$pod\"}",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 1,
      "title": "CPU usage",
      "description": "CPU time per second across the workerd container's cores.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "cores", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "CPU throttled periods",
      "description": "Percentage of CFS periods in which the container was throttled. Requires a CPU quota.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (namespace, pod) (rate(container_cpu_cfs_throttled_periods_total{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])) / (sum by (namespace, pod) (rate(container_cpu_cfs_periods_total{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory working set",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod) (container_memory_working_set_bytes{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memory working set / limit",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (namespace, pod) (container_memory_working_set_bytes{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"} / (container_spec_memory_limit_bytes{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"} > 0 < 1e18))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Scrape health",
      "description": "1 means the last scrape succeeded. Kubelet targets appear when node discovery succeeds.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"krun-kubelet-cadvisor|vmagent|victoria-metrics\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    }
  ]
}
