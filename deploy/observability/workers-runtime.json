{
  "uid": "krun-workers-runtime",
  "title": "krun Workers Runtime",
  "schemaVersion": 41,
  "tags": ["krun", "workers"],
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
        "query": "label_values(container_memory_working_set_bytes{job=\"krun-kubelet-cadvisor\"}, namespace)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
        "query": "label_values(container_memory_working_set_bytes{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\"}, pod)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU usage",
      "description": "CPU time per second across the workerd container's cores.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "cores", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "CPU throttled periods",
      "description": "Percentage of CFS periods in which the container was throttled. Requires a CPU quota.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (namespace, pod) (rate(container_cpu_cfs_throttled_periods_total{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])) / (sum by (namespace, pod) (rate(container_cpu_cfs_periods_total{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory working set",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod) (container_memory_working_set_bytes{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memory working set / limit",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (namespace, pod) (container_memory_working_set_bytes{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"} / (container_spec_memory_limit_bytes{job=\"krun-kubelet-cadvisor\",namespace=~\"$namespace\",pod=~\"$pod\"} > 0 < 1e18))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Scrape health",
      "description": "1 means the last scrape succeeded. Kubelet targets appear when node discovery succeeds.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"krun-kubelet-cadvisor|vmagent|victoria-metrics\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    }
  ]
}
